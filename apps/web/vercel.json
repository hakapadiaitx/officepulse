{
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/late-alert",
      "schedule": "0 9 * * *"
    }
  ]
}
